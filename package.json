{
  "name": "yurajs",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun ./examples/hello/index.html",
    "dev:model": "bun ./examples/model/index.html",
    "showcase": "bun ./apps/showcase/index.html",
    "bench": "bun ./apps/benchmarks/index.html",
    "dev:three": "bun ./examples/three/index.html",
    "dev:lyrics": "bun ./examples/lyrics/index.html",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "play": "bun run apps/playground/server.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.13",
    "@webgpu/types": "^0.1.44",
    "typescript": "^5.6.0"
  }
}
